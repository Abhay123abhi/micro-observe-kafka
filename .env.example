# Choose one provider mode:
# OpenAI: set AI_ENABLED=true, AI_CHAT_PROVIDER=openai, and a real OPENAI_API_KEY.
# Free local Ollama: use the values below after installing Ollama on the host.
AI_ENABLED=false
AI_CHAT_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_BASE_URL=
AI_MODEL=gpt-5-mini
INCIDENT_MAXIMUM_PAGE_SIZE=100
INCIDENT_RESOLVED_RETENTION_DAYS=30
INCIDENT_OUTBOX_RETENTION_DAYS=7
TRACING_ENABLED=true
