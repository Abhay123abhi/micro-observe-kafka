POSTGRES_PASSWORD=choose-a-local-password
GRAFANA_ADMIN_PASSWORD=choose-a-grafana-password
BIND_ADDRESS=127.0.0.1

# Email is optional: enable the email Compose profile after configuring SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM=
ALERT_EMAIL_TO=
SMTP_AUTH=true
SMTP_STARTTLS=true

INCIDENT_MAXIMUM_PAGE_SIZE=100
INCIDENT_RESOLVED_RETENTION_DAYS=30
INCIDENT_OUTBOX_RETENTION_DAYS=7
TRACING_ENABLED=true
